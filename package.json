    ".": {
      "browser": "./pieeg.js",
      "import": "./pieeg.js",
      "require": "./pieeg.js",
      "default": "./pieeg.js"
    }
  },
  "files": [
    "pieeg.js"
  ],
  "sideEffects": false,
